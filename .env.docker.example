# Blue Pine Solutions Mail self-hosted configuration. Copy to .env.docker and edit.
# See docs/self-hosting.md for every option.

PORT=3000
DATA_DIR=/data
# Public URL when running behind a reverse proxy.
# APP_URL=https://mail.example.com

# Inbound mail: the built-in SMTP listener. Point your MX record at this host.
SMTP_INBOUND_PORT=25
# MAIL_HOSTNAME=mail.example.com
# SMTP_TLS_KEY=/data/tls/key.pem
# SMTP_TLS_CERT=/data/tls/cert.pem

# Outbound mail through any SMTP relay (smtps:// for implicit TLS, smtp:// for STARTTLS).
# SMTP_URL=smtps://user:password@smtp.example.com:465

# Or Cloudflare Email Sending, and optional zone management.
# CF_ACCOUNT_ID=
# CF_TOKEN=

# Inbound through the Cloudflare Email Routing relay Worker instead of port 25.
# INBOUND_WEBHOOK_SECRET=

# Optional: turn features off for this installation (comma-separated):
# customBranding, multipleAccounts, sharedMailboxes, accountForwarding, gravatar
# BLUEPINE_DISABLED_FEATURES=

# Optional: email assistant (OpenAI-compatible API).
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
